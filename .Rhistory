library(ggplot2)    # Faire de beaux graphiques
library(knitr)      # Faciliter la mise en forme
library(glmnet)     # Utiliser des régressions pénalisées
library(caret)      # Manipulation de validation croisée
# Données simulées
x <- 1:10
y <- 2 + 0.5*x + rnorm(10, sd = 1)
mod_mco <- lm(y ~ x)
summary(mod_mco)
b = coef(mod_mco)[1]
a = coef(mod_mco)[2]
G.mco = sum((y - b - a*x)**2)
G.mco
# Pour les x et y définis précédemment
SCR <- function(b0,b1){
0.5*sum((y - b0 - b1*x)**2)
}
lambda = 5
# Pour les x et y définis précédemment
LASSO <- function(b0,b1){
0.5*sum((y - b0 - b1*x)**2) + lambda * (abs(b0) + abs(b1))
}
# Grille de coefficients
b0 <- seq(0, 8, length.out = 200)
b1 <- seq(-0.5, 1, length.out = 200)
# Matrices de valeurs pour contour plot
S <- outer(b0, b1, Vectorize(SCR))
Spen <- outer(b0, b1, Vectorize(LASSO))
# ---- FIGURE 1 : contours superposés ----
contour(b0, b1, S, nlevels = 30, col = "blue",
xlab = expression(beta[0]), ylab = expression(beta[1]),
main = "Contours MCO (bleu) et LASSO pénalisé (vert)")
# Grille de coefficients
b0 <- seq(0, 8, length.out = 200)
b1 <- seq(-0.5, 1, length.out = 200)
# Matrices de valeurs pour contour plot
S <- outer(b0, b1, Vectorize(SCR))
Spen <- outer(b0, b1, Vectorize(LASSO))
contour(b0, b1, S, nlevels = 30, col = "blue",
xlab = expression(beta[0]), ylab = expression(beta[1]),
main = "Contours MCO")
points(b, a, pch = 19, col = "red")
pen <- outer(b0, b1, Vectorize(function(b0, b1) lambda*(abs(b0) + abs(b1))))
contour(b0, b1, pen, nlevels = 20,
xlab = expression(beta[0]),
ylab = expression(beta[1]),
main = "Contours de la pénalisation L1 (losanges)",
col = "red", add = TRUE)
# Grille de coefficients
b0 <- seq(0, 8, length.out = 200)
b1 <- seq(-0.5, 1, length.out = 200)
# Matrices de valeurs pour contour plot
S <- outer(b0, b1, Vectorize(SCR))
Spen <- outer(b0, b1, Vectorize(LASSO))
contour(b0, b1, S, nlevels = 30, col = "blue",
xlab = expression(beta[0]), ylab = expression(beta[1]),
main = "Contours MCO")
pen <- outer(b0, b1, Vectorize(function(b0, b1) lambda*(abs(b0) + abs(b1))))
contour(b0, b1, pen, nlevels = 20,
xlab = expression(beta[0]),
ylab = expression(beta[1]),
main = "Contours de la pénalisation L1 (losanges)",
col = "red", add = TRUE)
points(b, a, pch = 19, col = "blue")
contour(b0, b1, S, nlevels = 30, col = "blue",
xlab = expression(beta[0]), ylab = expression(beta[1]),
main = "Contours MCO (bleu) et pénalisation L1 (rouge)")
pen <- outer(b0, b1, Vectorize(function(b0, b1) lambda*(abs(b0) + abs(b1))))
contour(b0, b1, pen, nlevels = 20,
col = "red", add = TRUE)
points(b, a, pch = 19, col = "blue")
contour(b0, b1, S, nlevels = 30, col = "blue",
xlab = expression(beta[0]), ylab = expression(beta[1]),
main = "Contours MCO (bleu) et pénalisation L1 (rouge)")
pen <- outer(b0, b1, Vectorize(function(b0, b1) lambda*(abs(b0) + abs(b1))))
contour(b0, b1, pen, nlevels = 20,
col = "red", add = TRUE)
points(b, a, pch = 19, col = "blue")
