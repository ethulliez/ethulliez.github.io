library(ggplot2)    # Faire de beaux graphiques
library(knitr)      # Faciliter la mise en forme
library(glmnet)     # Utiliser des régressions pénalisées
library(caret)      # Manipulation de validation croisée
dataApp <- read.table("Datasets/TrainingDataSet_Maize.txt")
dataTest <- read.table("Datasets/TestDataSet_Maize.txt")
# Résumé des données
dim(dataApp)
# Boxplot
ggplot(data = dataApp, mapping = aes(y = yield_anomaly)) + geom_boxplot() + xlab("Yield anomaly (t/ha)")
# Matrice des corrélations
cormat <- cor(dataApp)
corrplot::corrplot(cormat)
X <- as.matrix(dataApp[, - c(1:3)])
Y <- as.vector(dataApp$yield_anomaly)
# Le paramètre alpha = 1 permet de spécifier un modèle LASSO.
mod.LASSO <- glmnet(x = X, y = Y, alpha = 1)
summary(mod.LASSO)
NL = length(mod.LASSO$lambda)
ggplot(mapping = aes(x = mod.LASSO$lambda)) +
geom_histogram(binwidth = 0.01) +
xlab("Lambda") + ylab("Occurences") + ggtitle(paste0("Répartition des ", NL, " valeurs de lambda."))
beta <- coef(mod.LASSO)
beta[,c(1,40,80)] # On affiche les coefficients estimés pour certaines valeurs de lambda
plot(mod.LASSO, label = TRUE, sign.lambda = 1)
K = 5               # Nombre de folds
n = nrow(dataApp)   # Nombre de données d'apprentissage
# Tirage aléatoire des données de chaque fold
set.seed(1111)
sublist <- createFolds(y = 1:n, k = K)
# Construction de chaque sous-jeu de données
# dataFold1 <- dataApp[sublist[[1]],]
# dataFold2 <- dataApp[sublist[[2]],]
# dataFold3 <- dataApp[sublist[[3]],]
# dataFold4 <- dataApp[sublist[[4]],]
# dataFold5 <- dataApp[sublist[[5]],]
# Choix d'un lambda
lambda = mod.LASSO$lambda[10]
MSE.list = rep(0,K)
for(k in 1:K){
dataFoldApp <- dataApp[-sublist[[k]],]
dataFoldTest <- dataApp[sublist[[k]],]
lasso.CV <- glmnet(x = as.vector(dataFoldApp$yield_anomaly), y = as.matrix(dataFoldApp[, -c(1:3)]), alpha = 1, lambda = lambda)
y.pred <- predict(lasso.CV, newx = as.matrix(dataFoldTest[,-c(1:3)]))
# Calcul du MSE
MSE.list[k] <- mean((dataFoldTest$yield_anomaly - y.pred)**2)
}
View(dataFoldApp)
k
t= dataFoldApp[, -c(1:3)]
View(t)
lasso.CV <- glmnet(x = as.vector(dataFoldApp$yield_anomaly), y = as.matrix(dataFoldApp[, -c(1:3)]), alpha = 1, lambda = lambda)
# Choix d'un lambda
lambda = mod.LASSO$lambda[10]
MSE.list = rep(0,K)
for(k in 1:K){
dataFoldApp <- dataApp[-sublist[[k]],]
dataFoldTest <- dataApp[sublist[[k]],]
lasso.CV <- glmnet(x = as.matrix(dataFoldApp[, -c(1:3)]), y = as.vector(dataFoldApp$yield_anomaly), alpha = 1, lambda = lambda)
y.pred <- predict(lasso.CV, newx = as.matrix(dataFoldTest[,-c(1:3)]))
# Calcul du MSE
MSE.list[k] <- mean((dataFoldTest$yield_anomaly - y.pred)**2)
}
set.seed(1111)
LASSO.CV <- cv.glmnet(x = X, y = Y, alpha = 1, nfolds = 5)
plot(LASSO.CV, sign.lambda = 1)
LASSO.CV$cvm[10]
c(CVMSE_Manuel = CVMSE, CVMSE_Auto = LASSO.CV$cvm[10]))
c(CVMSE_Manuel = CVMSE, CVMSE_Auto = LASSO.CV$cvm[10])
CVMSE <- mean(MSE.list)
round(CVMSE,3)
set.seed(1111)
LASSO.CV <- cv.glmnet(x = X, y = Y, alpha = 1, nfolds = 5)
plot(LASSO.CV, sign.lambda = 1)
c(CVMSE_Manuel = CVMSE, CVMSE_Auto = LASSO.CV$cvm[10])
set.seed(1111)
LASSO.CV <- cv.glmnet(x = X, y = Y, alpha = 1, nfolds = 5)
plot(LASSO.CV, sign.lambda = 1)
comp <- c(CVMSE_Manuel = CVMSE, CVMSE_Auto = LASSO.CV$cvm[10])
kable(round(comp,4))
kable(t(round(comp,4)))
lasso.min <- glmnet(x = X, y = Y, alpha = 1, lambda = LASSO.CV$lambda.1se)
yt.pred <- predict(lasso.min, newx = as.matrix(dataTest[,-c(1:3)]))
summary(dataTest$yield_anomaly)
sd(dataTest$yield_anomaly)
